{
  "name": "vue-boilerplate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.12.0"
  },
  "scripts": {
    "dev": "vite",
    "serve": "npm run dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:testing": "npm run build -- -- --mode testing",
    "build:staging": "npm run build -- -- --mode staging",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix && stylelint 'src/**/*.{css,vue}' --fix",
    "format": "prettier --write src/",
    "mock": "nodemon --watch ./mock scripts/mock.cjs",
    "start": "npm run dev & npm run mock& npm run openapi",
    "serve:sa": "cross-env VITE_APP_SADATA_DEBUG=true vite",
    "iconfont:gen": "gulp --cwd=./ --gulpfile combine-icons/builder/gulpfile.cjs iconfont:gen",
    "minify:fonts": "gulp --cwd=./ --gulpfile minify-fonts/builder/gulpfile.js",
    "prepare": "husky install",
    "preinstall": "node ./scripts/check-package-manager.js npm",
    "openapi": "node scripts/openapi.js -c ./openapi.config.js"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "bezier-easing": "^2.1.0",
    "bignumber.js": "^9.1.2",
    "countup.js": "^2.8.0",
    "is-url": "^1.2.4",
    "lodash-es": "^4.17.21",
    "pinia": "^2.1.7",
    "resize-observer-polyfill": "^1.5.1",
    "vant": "^4.8.1",
    "vue": "^3.4.3",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^18.4.3",
    "@faker-js/faker": "^8.3.1",
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/glob-parent": "^5.1.3",
    "@types/is-url": "^1.2.32",
    "@types/jsdom": "^21.1.6",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^13.0.7",
    "@types/swagger2openapi": "^7.0.4",
    "@types/yargs-parser": "^21.0.3",
    "@vant/auto-import-resolver": "^1.0.2",
    "@vitejs/plugin-legacy": "^5.2.0",
    "@vitejs/plugin-vue": "^5.0.2",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.3",
    "@vue/tsconfig": "^0.5.0",
    "chalk": "^4.1.2",
    "commitizen": "^4.3.0",
    "commitlint": "^18.4.3",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "cypress": "^13.6.1",
    "eslint": "^8.49.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-vue": "^9.17.0",
    "express": "^4.18.2",
    "fancy-log": "^2.0.0",
    "fontmin": "^1.0.1",
    "glob-parent": "^6.0.2",
    "gulp": "^4.0.2",
    "gulp-cheerio": "^1.0.0",
    "gulp-consolidate": "^0.2.0",
    "gulp-iconfont": "^11.0.1",
    "gulp-if": "^3.0.0",
    "gulp-rename": "^2.0.0",
    "husky": "^8.0.3",
    "jsdom": "^23.0.1",
    "lint-staged": "^15.2.0",
    "mkdirp": "^3.0.1",
    "nodemon": "^3.0.2",
    "npm-run-all2": "^6.1.1",
    "openapi-typescript": "^6.7.3",
    "plugin-error": "^2.0.1",
    "postcss": "^8.4.32",
    "postcss-alias": "^2.0.0",
    "postcss-calc": "^9.0.1",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-nested": "^6.0.1",
    "postcss-preset-env": "^9.3.0",
    "postcss-px-to-viewport": "^1.1.1",
    "postcss-sprites": "^4.2.1",
    "postcss-viewport-height-correction": "^1.1.1",
    "prettier": "^3.0.3",
    "pretty-bytes": "^6.1.1",
    "require-dir": "^1.2.0",
    "start-server-and-test": "^2.0.3",
    "stylelint": "^16.0.2",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^35.0.0",
    "swagger2openapi": "^7.0.8",
    "typescript": "~5.3.0",
    "unplugin-auto-import": "^0.17.2",
    "unplugin-icons": "^0.19.0",
    "unplugin-inject-preload": "^2.0.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.10",
    "vite-plugin-ejs": "^1.7.0",
    "vitest": "^1.0.4",
    "vue-tsc": "^1.8.27",
    "yargs-parser": "^21.1.1"
  },
  "browserslist": [
    "iOS >= 10.0",
    "Chrome >= 51"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,vue}": [
      "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix"
    ],
    "src/**/*.{css,vue}": [
      "stylelint --fix"
    ]
  }
}
